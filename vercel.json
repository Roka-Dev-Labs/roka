{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "docs/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "dashboard/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "js/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "media/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "site.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "openapi.json",
      "use": "@vercel/static"
    },
    {
      "src": "*.md",
      "use": "@vercel/static"
    },
    {
      "src": "llms.txt",
      "use": "@vercel/static"
    },
    {
      "src": "llms-full.txt",
      "use": "@vercel/static"
    },
    {
      "src": ".well-known/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.sh",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/docs/?$",
      "dest": "/docs/index.html"
    },
    {
      "src": "^/pricing/?$",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "dest": "/pricing.md",
      "headers": {
        "content-type": "text/markdown; charset=utf-8",
        "content-location": "/pricing.md",
        "vary": "Accept",
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "src": "^/pricing/?$",
      "dest": "/pricing.html"
    },
    {
      "src": "^/checkout/?$",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "dest": "/checkout.md",
      "headers": {
        "content-type": "text/markdown; charset=utf-8",
        "content-location": "/checkout.md",
        "vary": "Accept",
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "src": "^/checkout/?$",
      "dest": "/checkout.html"
    },
    {
      "src": "^/robots\\.txt$",
      "dest": "/robots.txt",
      "headers": {
        "content-type": "text/plain; charset=utf-8",
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "src": "^/llms\\.txt$",
      "dest": "/llms.txt",
      "headers": {
        "content-type": "text/markdown; charset=utf-8",
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "src": "^/llms-full\\.txt$",
      "dest": "/llms-full.txt",
      "headers": {
        "content-type": "text/markdown; charset=utf-8",
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/sitemap.xml",
      "headers": {
        "content-type": "application/xml; charset=utf-8",
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "src": "^/openapi\\.json$",
      "dest": "/openapi.json",
      "headers": {
        "content-type": "application/vnd.oai.openapi+json; charset=utf-8",
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "src": "^/\\.well-known/api-catalog$",
      "dest": "/.well-known/api-catalog",
      "headers": {
        "content-type": "application/linkset+json; charset=utf-8",
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "src": "^/\\.well-known/mcp-server$",
      "dest": "/.well-known/mcp-server",
      "headers": {
        "content-type": "application/json; charset=utf-8",
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "src": "^/\\.well-known/security\\.txt$",
      "dest": "/.well-known/security.txt",
      "headers": {
        "content-type": "text/plain; charset=utf-8",
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "src": "^/favicon\\.svg$",
      "dest": "/assets/icons/favicon.svg"
    },
    {
      "src": "^/favicon\\.ico$",
      "dest": "/assets/icons/favicon.ico"
    },
    {
      "src": "^/favicon-([^/]+)$",
      "dest": "/assets/icons/favicon-$1"
    },
    {
      "src": "^/apple-touch-icon\\.png$",
      "dest": "/assets/icons/apple-touch-icon.png"
    },
    {
      "src": "^/logo-([^/]+)$",
      "dest": "/assets/logos/logo-$1"
    },
    {
      "src": "^/kevin\\.png$",
      "dest": "/assets/images/kevin.png"
    },
    {
      "src": "^/web-app-manifest-([^/]+)$",
      "dest": "/assets/manifest/web-app-manifest-$1"
    },
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "install.roka-prune.com" }],
      "dest": "/install.sh",
      "headers": {
        "content-type": "text/x-shellscript; charset=utf-8",
        "cache-control": "no-cache, no-store, must-revalidate",
        "x-content-type-options": "nosniff"
      }
    },
    {
      "src": "^/$",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "dest": "/index.md",
      "headers": {
        "content-type": "text/markdown; charset=utf-8",
        "content-location": "/index.md",
        "vary": "Accept",
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "src": "^/index\\.md$",
      "dest": "/index.md",
      "headers": {
        "content-type": "text/markdown; charset=utf-8",
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "src": "^/(.*)\\.md$",
      "headers": {
        "content-type": "text/markdown; charset=utf-8",
        "cache-control": "public, max-age=3600"
      },
      "continue": true
    },
    {
      "src": "^/install\\.sh$",
      "headers": {
        "content-type": "text/x-shellscript; charset=utf-8",
        "cache-control": "no-cache, no-store, must-revalidate",
        "x-content-type-options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "/media/(.*)\\.mp4$",
      "headers": {
        "content-type": "video/mp4",
        "cache-control": "public, max-age=86400",
        "accept-ranges": "bytes"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "link": "</openapi.json>; rel=\"service-desc\"; type=\"application/vnd.oai.openapi+json\", </.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\", </.well-known/mcp-server>; rel=\"mcp-server\"; type=\"application/json\", </index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\"; type=\"text/markdown\", </llms-full.txt>; rel=\"describedby\"; type=\"text/markdown\"",
        "vary": "Accept",
        "x-content-type-options": "nosniff",
        "x-frame-options": "DENY",
        "x-xss-protection": "1; mode=block",
        "referrer-policy": "strict-origin-when-cross-origin",
        "permissions-policy": "camera=(), microphone=(), geolocation=()",
        "content-security-policy": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdn.paddle.com https://sandbox-cdn.paddle.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com https://cdn.jsdelivr.net https://cdn.paddle.com https://sandbox-cdn.paddle.com; font-src 'self' https://fonts.gstatic.com https://cdn.fontshare.com https://cdn.jsdelivr.net https://cdn.paddle.com https://sandbox-cdn.paddle.com; img-src 'self' data: https:; media-src 'self'; frame-src https://buy.paddle.com https://sandbox-buy.paddle.com; connect-src 'self' https://roka-prune.com https://www.roka-prune.com https://api.roka-prune.com https://cdn.paddle.com https://sandbox-cdn.paddle.com https://api.paddle.com https://sandbox-api.paddle.com https://checkout-service.paddle.com https://sandbox-checkout-service.paddle.com; frame-ancestors 'none';",
        "strict-transport-security": "max-age=63072000; includeSubDomains; preload"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
